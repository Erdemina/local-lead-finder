# ---------------------------------------------------------------------------
# Local Lead Finder — environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database ---
# From the host (yarn dev / prisma migrate) use localhost; docker compose
# overrides the host with the service name.
DATABASE_URL=postgresql://llf:change_me@localhost:5432/leadfinder?schema=public
POSTGRES_USER=llf
POSTGRES_PASSWORD=change_me
POSTGRES_DB=leadfinder

# --- Redis (BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Public base URL of the app.
NEXTAUTH_URL=http://localhost:3000
# Host port the app is published on (docker compose only).
APP_PORT=3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# 32-byte base64 key used to encrypt provider API keys at rest in the database.
# Generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=

# --- First-run admin account ---
# The seed script creates a super admin with these values and re-syncs the
# username + password every time it runs. Login is by username.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Generated demo sites ---
# Directory the worker writes generated sites into (path inside the container).
SITES_OUTPUT_DIR=/data/websites
PUBLIC_SITES_BASE_URL=http://localhost:8080
# Host directory bind-mounted for the generated sites (docker compose only).
SITES_HOST_DIR=./data/websites

# --- Geocoding ---
# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT=LocalLeadFinder/1.0 (you@example.com)

# --- AI search & scoring (optional) ---
# In normal use these keys are entered in the Admin › Data Sources screen and
# stored encrypted in the database. The values below are a local-dev fallback.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
